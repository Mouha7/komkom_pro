{
  "name": "mobile",
  "license": "0BSD",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --lan",
    "start:lan": "expo start --lan",
    "start:tunnel": "expo start --tunnel",
    "start:localhost": "expo start --localhost",
    "start:clear": "expo start --lan -c",
    "start:tunnel:clear": "expo start --tunnel -c",
    "start:go:lan": "expo start --go --lan -c --port 8081",
    "start:go:tunnel": "expo start --go --tunnel -c --port 8081",
    "start:kill-metro": "node ./scripts/kill-metro.js",
    "start:stable": "npm run start:kill-metro && npm run start:go:lan",
    "start:stable:tunnel": "npm run start:kill-metro && npm run start:go:tunnel",
    "start:dev:lan": "npm run start:kill-metro && expo start --dev-client --lan -c --port 8081",
    "start:dev:tunnel": "npm run start:kill-metro && expo start --dev-client --tunnel -c --port 8081",
    "eas:login": "npx --yes eas-cli login",
    "build:dev:android": "npx --yes eas-cli build --platform android --profile development",
    "build:dev:ios": "npx --yes eas-cli build --platform ios --profile development",
    "build:dev:ios:interactive": "npx --yes eas-cli build --platform ios --profile development --no-wait",
    "build:dev:ios:simulator": "npx --yes eas-cli build --platform ios --profile development-simulator --non-interactive --no-wait",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "expo-dev-client": "~6.0.20",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  },
  "private": true
}
