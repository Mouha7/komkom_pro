# API Configuration - Local Development
# Mock service is built-in, runs entirely on localhost
# No external server needed
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001

# Note: ngrok-based tunnel mode is no longer needed since mock service is in-memory

# Keep SplashScreen dev-bypass button visible in release APK (demo)
EXPO_PUBLIC_ENABLE_DEMO_BYPASS=true

# Google Maps SDK for Android API key — required for the interactive map in
# LocationPickerModal (signup + adjust position). Leave empty to fall back to the
# ErrorBoundary "Carte indisponible" UI in release APK builds.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

