# ========================================
# KOMKOM - Environment Variables Template
# ========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git (contains secrets)

# ========================================
# Database (PostgreSQL)
# ========================================
POSTGRES_USER=komkom
POSTGRES_PASSWORD=komkom_secure_password_change_me
POSTGRES_DB=komkom
# Connection string: postgresql://POSTGRES_USER:POSTGRES_PASSWORD@postgres:5432/POSTGRES_DB

# ========================================
# Redis
# ========================================
REDIS_URL=redis://redis:6379/0
# Used by: products_service (cache), cart_service (data), orders_service (sessions)
# Multiple databases: 
#   - 0: products cache
#   - 1: cart data
#   - 2: orders sessions

# ========================================
# RabbitMQ (Message Broker)
# ========================================
RABBITMQ_DEFAULT_USER=rabbit
RABBITMQ_DEFAULT_PASS=rabbit_secure_password_change_me
RABBITMQ_URL=amqp://rabbit:rabbit_secure_password_change_me@rabbitmq:5672//
# Connection for: celery_worker, event publishers/consumers

# ========================================
# MinIO (S3-compatible object storage)
# ========================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio_secure_password_change_me
MINIO_ENDPOINT=http://minio:9000
# Used by: invoice generation, file uploads, media storage

# ========================================
# Keycloak (Authentication & Authorization)
# ========================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=keycloak_secure_password_change_me
# Realm: master (default, change for prod)
# JWKS URL: http://keycloak:8080/realms/master/protocol/openid-connect/certs
KEYCLOAK_REALM=master
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/master/protocol/openid-connect/certs

# ========================================
# Services Environment
# ========================================

# --- Products Catalog Service ---
PRODUCTS_DB_URL=postgresql://komkom:komkom_secure_password_change_me@postgres:5432/komkom
PRODUCTS_REDIS_URL=redis://redis:6379/0
PRODUCTS_RABBITMQ_URL=amqp://rabbit:rabbit_secure_password_change_me@rabbitmq:5672//
PRODUCTS_SERVICE_NAME=products
PRODUCTS_SERVICE_HOST=products_service
PRODUCTS_SERVICE_PORT=8000

# --- Cart Service ---
CART_REDIS_URL=redis://redis:6379/1
CART_RABBITMQ_URL=amqp://rabbit:rabbit_secure_password_change_me@rabbitmq:5672//
CART_SERVICE_NAME=cart
CART_SERVICE_HOST=cart_service
CART_SERVICE_PORT=8000

# --- Orders Service ---
ORDERS_DB_URL=postgresql://komkom:komkom_secure_password_change_me@postgres:5432/komkom
ORDERS_REDIS_URL=redis://redis:6379/2
ORDERS_RABBITMQ_URL=amqp://rabbit:rabbit_secure_password_change_me@rabbitmq:5672//
ORDERS_SERVICE_NAME=orders
ORDERS_SERVICE_HOST=orders_service
ORDERS_SERVICE_PORT=8000

# ========================================
# Celery Worker Configuration
# ========================================
CELERY_BROKER_URL=amqp://rabbit:rabbit_secure_password_change_me@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP=true

# ========================================
# PgAdmin (Optional Development Tool)
# ========================================
PGADMIN_DEFAULT_EMAIL=pgadmin@local.test
PGADMIN_DEFAULT_PASSWORD=pgadmin_password

# ========================================
# Application Settings
# ========================================
# Base protocol and hostnames used by Traefik host routing in local Docker
PROTOCOL=http
DOMAIN=localhost
DOMAIN_KEYCLOAK=keycloak.localhost
DOMAIN_PRODUCTS=products.localhost
DOMAIN_CART=cart.localhost
DOMAIN_ORDERS=orders.localhost

# ACME email is used by Traefik only in production TLS mode
ACME_EMAIL=admin@komkom.io

# API versions
API_VERSION=v1

# Debug mode (set to 'false' in production)
DEBUG=true
LOG_LEVEL=INFO

# JWT Token expiry (seconds)
TOKEN_EXPIRY=3600
REFRESH_TOKEN_EXPIRY=86400

# ========================================
# CORS & Security (Frontend Integration)
# ========================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:5000
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
ALLOWED_HEADERS=Content-Type,Authorization

# ========================================
# Monitoring & Observability (Optional)
# ========================================
# Sentry DSN for error tracking
SENTRY_DSN=

# OpenTelemetry collector endpoint (OTEL)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ========================================
# Email Configuration (for notifications)
# ========================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@komkom.io
SMTP_PASSWORD=smtp_password
SMTP_FROM_NAME=KomKom Platform

# ========================================
# Localization & Defaults
# ========================================
DEFAULT_CURRENCY=USD
DEFAULT_LANGUAGE=en
TIMEZONE=UTC

# ========================================
# Feature Flags (Optional)
# ========================================
ENABLE_NOTIFICATIONS=true
ENABLE_INVENTORY_RESERVE=true
ENABLE_INVOICE_GENERATION=true
